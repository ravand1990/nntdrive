# Copy to .env next to docker-compose.release.yml (optional).
# Leave either value empty/unset to generate it once with nntdrive-compose.py.
# Explicit values are adopted only on a fresh installation, never rotated.
POSTGRES_PASSWORD=

# Used to encrypt provider passwords at rest; explicit values must be
# base64 encoding of 32 random bytes. Generated values need no manual command.
NNTDRIVE_SECRET_KEY=

# Published image. Pin a version for reproducible upgrades.
NNTDRIVE_IMAGE=ghcr.io/ravand1990/nntdrive-backend
NNTDRIVE_VERSION=latest

# Bind the backend to loopback when a TLS proxy is in front.
NNTDRIVE_HOST_BIND=127.0.0.1
NNTDRIVE_HOST_PORT=8080

# Only needed for the "tls" Compose profile (Caddy automatic HTTPS).
NNTDRIVE_DOMAIN=drive.example.com

# Optional initial providers (JSON array). Can also be added in /admin,
# then use Maintenance -> Restart backend.
# NNTDRIVE_NNTP_PROVIDERS=[{"name":"eweka","host":"news.eweka.nl","port":563,"tls":true,"username":"USER","password":"PASS","max_connections":8,"role":"retrieval_only","priority":100,"groups":["alt.binaries.test"],"message_id_domain":"nntdrive.local","connect_timeout_secs":30,"io_timeout_secs":60,"retention_days":null,"max_retries":3},{"name":"eweka-post","host":"post.eweka.nl","port":563,"tls":true,"username":"USER","password":"PASS","max_connections":4,"role":"posting_only","priority":10,"groups":["alt.binaries.test"],"message_id_domain":"nntdrive.local","connect_timeout_secs":30,"io_timeout_secs":60,"retention_days":null,"max_retries":3}]

RUST_LOG=info,sqlx=warn
LOG_FORMAT=json
