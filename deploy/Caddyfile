{$NNTDRIVE_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 200MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}
	reverse_proxy backend:8080 {
		flush_interval -1
	}
	log {
		output stdout
		format json
	}
}
