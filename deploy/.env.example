# Copy to deploy/.env and fill in. Never commit the filled file.

POSTGRES_PASSWORD=change-me-to-a-long-random-value

# 32 random bytes, base64. Generate with:
#   openssl rand -base64 32
# Used only to encrypt NNTP provider passwords at rest.
NNTDRIVE_SECRET_KEY=

# Public registration is off by default. The first account created is the admin.
NNTDRIVE_ALLOW_REGISTRATION=false

# Reverse proxy (only needed with the "tls" compose profile).
NNTDRIVE_DOMAIN=drive.example.com

# Bind the published backend port to loopback when a TLS proxy is in front.
NNTDRIVE_HOST_BIND=127.0.0.1
NNTDRIVE_HOST_PORT=8080

# Local encrypted cache (bytes). Must not exceed the cache volume.
NNTDRIVE_CACHE_LIMIT_BYTES=10737418240
# NNTDRIVE_DEFAULT_QUOTA_BYTES=536870912000
# NNTDRIVE_HEALTH_INTERVAL_SECS=21600
# NNTDRIVE_REFRESH_DAYS=180
# NNTDRIVE_REFRESH_INTERVAL_SECS=86400

# Initial providers (JSON array). Can also be added in the admin dashboard,
# which requires a restart. Never commit real credentials.
# NNTDRIVE_NNTP_PROVIDERS=[{"name":"eweka","host":"news.eweka.nl","port":563,"tls":true,"username":"USER","password":"PASS","max_connections":8,"role":"both","priority":0,"groups":["alt.binaries.nntdrive"],"message_id_domain":"nntdrive.local","connect_timeout_secs":30,"io_timeout_secs":60,"retention_days":null,"max_retries":3}]

RUST_LOG=info,sqlx=warn
LOG_FORMAT=json
