# Per-worktree container dependency caches and build outputs
/.toolchain/

# Rust
/target
**/target
*.rs.bk

# Local runtime data and secrets - never commit
/.env
/data
/cache
*.key
*.nntdrive-kit
recovery-kit-*.json
*.db
*.sqlite3
crash.log

# Flutter / Dart
clients/flutter/.dart_tool/
clients/flutter/build/
clients/flutter/.flutter-plugins*
clients/flutter/.packages
clients/flutter/ios/Pods/
clients/flutter/android/.gradle/
clients/flutter/android/local.properties
clients/flutter/windows/flutter/ephemeral/
clients/flutter/linux/flutter/ephemeral/

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
deploy/.env
*.recovery.json
*.nntdrive-part
# Generated native libraries
clients/flutter/linux/lib/*.so
clients/flutter/android/app/src/main/jniLibs/
clients/flutter/windows/runner/*.dll
bootstrap-credentials/
